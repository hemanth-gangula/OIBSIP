# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — Oasis Infobyte Fraud Detection Project
# ─────────────────────────────────────────────────────────────────────────────

# ── Dataset (too large for GitHub, 144 MB) ───────────────────────────────────
data/creditcard.csv
data/*.csv

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
# lib/ intentionally not excluded — would match app/frontend/lib/
lib64/
parts/
sdist/
var/
wheels/
*.spec

# ── Virtual environments ─────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Model artifacts (large binary files — regenerate with run_training.bat) ──
# Uncomment to exclude pkl files from git (they can be large):
# models/*.pkl

# ── Secrets and local config ─────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
app/backend/.env
app/frontend/.env.local

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
app/frontend/node_modules/
app/frontend/.next/
app/frontend/out/
app/frontend/.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
training_log.txt
evaluation_log.txt
test_output.txt
final_audit_test.txt

# ── Temporary build helpers (removed from root, excluded if re-added) ────────
run_*.bat
validate_nb.py
build_notebook.py
inspect_dataset.py
verify_artifacts.py
