# FastAPI Backend Environment Variables
# Copy this file to .env and fill in values.
# Never commit the real .env to git.

# Host and port for local development
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins (comma-separated)
# In production restrict to your Vercel frontend URL
CORS_ORIGINS=http://localhost:3000,https://your-project.vercel.app

# Log level: debug | info | warning | error
LOG_LEVEL=info
