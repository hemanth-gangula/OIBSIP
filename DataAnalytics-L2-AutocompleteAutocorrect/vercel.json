{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": [
          "notebooks/**",
          "tests/**",
          ".pytest_cache/**",
          "outputs/figures/**",
          "__pycache__/**",
          ".git/**",
          "data/big.txt",
          ".agents/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/app.py"
    }
  ]
}
