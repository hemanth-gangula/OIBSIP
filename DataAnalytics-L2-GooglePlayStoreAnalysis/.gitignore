# ──────────────────────────────────────────────────────────────────────────────
# .gitignore — Oasis Infobyte L2 Task 4 Google Play Store Analysis
# ──────────────────────────────────────────────────────────────────────────────

# ── Datasets (upload via the app UI — never committed to git) ─────────────────
uploads/
*.csv
*.xlsx
*.xls

# ── Generated chart images (produced at runtime by notebook / Flask) ──────────
chart_*.png
*.png

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/

# ── Jupyter checkpoints ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Temporary / test files ────────────────────────────────────────────────────
test_pipeline.py
test_http.py
validate_nb.py
*.log

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
